APP_NAME="MuOnline Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
AUTO_MIGRATE=false
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

GAME_DB_CONNECTION=sqlsrv
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=1433
GAME_DB_MUONLINE=MuOnline
GAME_DB_RANKING=
GAME_RANKING_CONNECTION=game
GAME_DB_USERNAME=
GAME_DB_PASSWORD=
GAME_DB_ENCRYPT=true
GAME_DB_TRUST_SERVER_CERTIFICATE=false
GAME_DB_READONLY=true
GAME_WRITES_ENABLED=false
GAME_DB_APP_NAME="MuOnline Web Read Model"
GAME_DB_LOGIN_TIMEOUT=5

GAME_DATA_SOURCE=fixture
GAME_ACCOUNT_PASSWORD_SCHEME=plaintext
GAME_PASSWORD_RESET_TTL_MINUTES=60
GAME_RANKING_LIMIT=10
GAME_EVENT_TIMEZONE=Europe/Sofia
GAME_EVENT_PROFILE=darksteam_97d99i
GAME_EVENT_HOME_LIMIT=3
GAME_SERVER_NAME="MuOnline 97d+99i"
GAME_SERVER_VERSION="97d + 99i"
GAME_SERVER_EXPERIENCE=9999x
GAME_SERVER_DROP=60%
GAME_SERVER_CAPACITY=500

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
