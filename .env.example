APP_NAME="MuOnline Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# DEMO ACCESS
# Demo mode keeps administration, identity and payment changes read-only.
# Listed game accounts may still use player operations such as resets and Market.
DEMO_MODE=false
DEMO_ACCOUNTS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# APPLICATION DATABASE
# Laravel-owned data: administrators, content, settings, payments and history.
# This connection targets MuOnline_Web, never the MuOnline game database.
DB_CONNECTION=sqlsrv
AUTO_MIGRATE=true
DB_HOST=replace-with-sql-server-host
DB_PORT=1433
DB_DATABASE=MuOnline_Web
DB_USERNAME=muonline_web_app
DB_PASSWORD=replace-with-a-long-random-runtime-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_APP_NAME="MuOnline Web Application"
DB_LOGIN_TIMEOUT=5

# APPLICATION DATABASE — FIRST START ONLY
# Enable only when DB_CONNECTION=sqlsrv and MuOnline_Web does not exist yet.
# These temporary administrator credentials are removed after the first start.
APP_DB_BOOTSTRAP=true
APP_DB_SEED=true
APP_DB_ADMIN_USERNAME=sa
APP_DB_ADMIN_PASSWORD=replace-with-the-current-sa-password

# Fixture-only SQLite alternative:
# Set DB_CONNECTION=sqlite, AUTO_MIGRATE=false and APP_DB_BOOTSTRAP=false.
# The DB_HOST/DB_PORT/DB_* credentials are ignored by the SQLite connection.

# GAME DATABASE
# Legacy MuOnline-owned data: accounts, characters, guilds and inventories.
# Use a dedicated restricted game login; never use sa here.
GAME_DB_CONNECTION=sqlsrv
GAME_DB_HOST=replace-with-sql-server-host
GAME_DB_PORT=1433
GAME_DB_MUONLINE=MuOnline
GAME_DB_RANKING=
GAME_RANKING_CONNECTION=game
GAME_DB_USERNAME=replace-with-restricted-game-login
GAME_DB_PASSWORD=replace-with-restricted-game-password
# Optional when the game database uses another SQL Server administrator.
# Empty values fall back to APP_DB_ADMIN_* during the one-time bootstrap only.
GAME_DB_ADMIN_USERNAME=
GAME_DB_ADMIN_PASSWORD=
GAME_DB_ENCRYPT=true
GAME_DB_TRUST_SERVER_CERTIFICATE=false
GAME_DB_APP_NAME="MuOnline Web Read Model"
GAME_DB_LOGIN_TIMEOUT=5

# GAME DATA SOURCE AND WRITE SAFETY
# Safe commissioning defaults. After game:doctor and disposable-account tests
# pass, a live account panel uses database/false/true.
GAME_DATA_SOURCE=fixture
GAME_DB_READONLY=true
GAME_WRITES_ENABLED=false

# GAME VERSION AND FEATURE BEHAVIOUR
# DarksTeam 1.0M uses darksteam_md5; 97d+99i uses plaintext.
GAME_ACCOUNT_PASSWORD_SCHEME=plaintext
GAME_PASSWORD_RESET_TTL_MINUTES=60
GAME_ACCOUNT_ACTIVATION_TTL_MINUTES=1440
GAME_RANKING_LIMIT=10
GAME_EVENT_TIMEZONE=Europe/Sofia
GAME_CONTENT_TIMEZONE=Europe/Sofia
GAME_EVENT_PROFILE=darksteam_97d99i
GAME_EVENT_HOME_LIMIT=3
GAME_MARKET_LISTING_DURATION_DAYS=30
GAME_SERVER_STATUS_HOST=127.0.0.1
GAME_SERVER_STATUS_PORT=55901
GAME_SERVER_STATUS_TIMEOUT_SECONDS=0.5
GAME_SERVER_STATUS_CACHE_SECONDS=10
GAME_SERVER_PROFILE=darksteam_97d99i
GAME_SERVER_NAME="MuOnline 97d+99i"
GAME_SERVER_VERSION="97d + 99i"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5
RECAPTCHA_HOSTNAME=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT_SECONDS=5

PAYMENTS_CURRENCY=EUR
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
REVOLUT_ENABLED=false
REVOLUT_MODE=sandbox
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
REVOLUT_API_VERSION=2026-08-17

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
