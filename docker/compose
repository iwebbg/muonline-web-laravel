#!/usr/bin/env bash

set -euo pipefail

docker_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_directory="$(dirname -- "$docker_directory")"
docker_environment_file="$docker_directory/.env"
application_environment_file="$project_directory/.env"

if [ ! -f "$docker_environment_file" ]; then
    echo "Docker configuration is missing. Copy docker/.env.example to docker/.env." >&2
    exit 1
fi

if [ ! -f "$application_environment_file" ]; then
    echo "Laravel configuration is missing. Copy .env.example to .env." >&2
    exit 1
fi

docker_environment="$(sed -n 's/^DOCKER_ENV=//p' "$docker_environment_file" | tail -n 1)"
compose_files=()
compose_project_arguments=()
integration_test=false

case "$docker_environment" in
    local)
        compose_files+=(
            "$docker_directory/docker-compose.local.yaml"
        )
        ;;
    prod|production)
        compose_files+=(
            "$docker_directory/docker-compose.prod.yaml"
        )
        ;;
    external)
        compose_files+=(
            "$docker_directory/docker-compose.prod.yaml"
            "$docker_directory/docker-compose.external.yaml"
        )
        ;;
    *)
        echo "DOCKER_ENV must be local, production or external." >&2
        exit 1
        ;;
esac

if [ "${1:-}" = "test" ]; then
    shift
    test_arguments=("$@")
    compose_files+=(
        "$docker_directory/docker-compose.test.yaml"
    )
    set -- run --rm --build --no-deps test composer test -- "${test_arguments[@]}"
elif [ "${1:-}" = "test-integration" ]; then
    shift
    test_arguments=("$@")
    compose_files=(
        "$docker_directory/docker-compose.integration-test.yaml"
    )
    compose_project_arguments=(
        --project-name muonline-web-integration
    )
    integration_test=true
    set -- run --rm --build integration-test composer test:integration -- "${test_arguments[@]}"
elif [ "${1:-}" = "test-integration-1.0m" ]; then
    shift
    test_arguments=("$@")
    compose_files=(
        "$docker_directory/docker-compose.integration-test-1.0m.yaml"
    )
    compose_project_arguments=(
        --project-name muonline-web-integration-1-0m
    )
    integration_test=true
    set -- run --rm --build integration-test composer test:integration-1.0m -- "${test_arguments[@]}"
fi

compose_file_arguments=()

for compose_file in "${compose_files[@]}"; do
    compose_file_arguments+=(
        --file "$compose_file"
    )
done

compose_command=(
    docker compose
    --project-directory "$docker_directory"
    "${compose_project_arguments[@]}"
    --env-file "$application_environment_file"
    --env-file "$docker_environment_file"
    "${compose_file_arguments[@]}"
    "$@"
)

# Diagnostic output belongs on stderr so machine-readable Compose stdout stays clean.
{
    printf '\n[MuOnline Web Compose]\n'
    printf 'Environment: %s\n' "$docker_environment"
    printf 'Compose files:\n'

    for compose_file in "${compose_files[@]}"; do
        printf '  - %s\n' "$compose_file"
    done

    printf 'Executing:'
    printf ' %q' "${compose_command[@]}"
    printf '\n\n'
} >&2

if [ "$integration_test" = true ]; then
    cleanup_command=(
        docker compose
        --project-directory "$docker_directory"
        "${compose_project_arguments[@]}"
        --env-file "$application_environment_file"
        --env-file "$docker_environment_file"
        "${compose_file_arguments[@]}"
        down
        --volumes
        --remove-orphans
    )

    "${cleanup_command[@]}" >/dev/null 2>&1 || true

    set +e
    "${compose_command[@]}"
    test_exit_code=$?
    "${cleanup_command[@]}"
    exit "$test_exit_code"
fi

exec "${compose_command[@]}"
